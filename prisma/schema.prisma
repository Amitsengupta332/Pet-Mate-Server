generator client {
  // provider = "prisma-client"
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  SITTER
  ADMIN
}

enum Status {
  ACTIVE
  SUSPENDED
}

enum ServiceType {
  WALKING
  BOARDING
  DAYCARE
  SITTING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sitterProfile SitterProfiles?
  pets          Pet[]

  booking Booking[]
  reviews Review[]

  @@index([status])
  @@map("users")
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  breed     String
  age       String
  notes     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  booking Booking[]
}

model SitterProfiles {
  id         String   @id @default(uuid())
  bio        String
  experience String
  hourlyRate Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sitterId String @unique
  user     User   @relation(fields: [sitterId], references: [id])

  services Service[]
  reviews  Review[]

  @@map("sitterProfile")
}

model Service {
  id          String      @id @default(uuid())
  serviceType ServiceType
  price       Float
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sitterId String
  sitter   SitterProfiles @relation(fields: [sitterId], references: [id])

  booking Booking[]

  @@map("services")
}

model Booking {
  id         String        @id @default(uuid())
  ownerId    String
  sitterId   String
  petId      String
  serviceId  String
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     BookingStatus @default(PENDING)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])
  pet   Pet  @relation(fields: [petId], references: [id])

  service Service @relation(fields: [serviceId], references: [id])
  review  Review?

  @@map("bookings")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int // 1 to 5
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id])
  sitterId  String
  sitter    SitterProfiles @relation(fields: [sitterId], references: [id])
  bookingId String         @unique
  booking   Booking        @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}
